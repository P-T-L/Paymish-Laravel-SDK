{
    "name": "bhekor/laravel-paymish",
    "description": "A Laravel package for integrating Paymish payment gateway API",
    "keywords": [
        "laravel",
        "paymish",
        "payment",
        "gateway",
        "nigeria",
        "api"
    ],
    "homepage": "https://github.com/bhekor/laravel-paymish",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Ibidapo Adeolu",
            "email": "adeoluibidapo@gmail.com",
            "homepage": "https://github.com/bhekor",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/bhekor/laravel-paymish/issues",
        "source": "https://github.com/bhekor/laravel-paymish"
    },
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.0",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Bhekor\\Paymish\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bhekor\\Paymish\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bhekor\\Paymish\\PaymishServiceProvider"
            ],
            "aliases": {
                "Paymish": "Bhekor\\Paymish\\Facades\\Paymish"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
