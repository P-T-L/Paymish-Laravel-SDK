{
    "name": "bhekor/laravel-paymish",
    "description": "A Laravel package for integrating Paymish payment gateway API",
    "keywords": [
        "laravel",
        "paymish",
        "payment",
        "gateway",
        "nigeria",
        "api"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Ibidapo Adeolu",
            "email": "bhekor@example.com",
            "homepage": "https://github.com/bhekor"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "orchestra/testbench": "^8.0|^9.0"
    },
    "autoload": {
        "psr-4": {
            "Bhekor\\Paymish\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bhekor\\Paymish\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bhekor\\Paymish\\PaymishServiceProvider"
            ],
            "aliases": {
                "Paymish": "Bhekor\\Paymish\\Facades\\Paymish"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
